{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NES Headerless Fixer",
  "version": "0.2.0",
  "identifier": "com.scdemanett.nes-headerless-fixer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev:renderer",
    "beforeBuildCommand": "npm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NES Headerless Fixer",
        "width": 920,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0c0e12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
